# API
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Leave empty for a single Vercel deployment (the Mini App calls same-origin /api routes).
NEXT_PUBLIC_API_URL=
BOT_TOKEN=
MINI_APP_URL=https://your-mini-app.example.com
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
APP_JWT_SECRET=replace-with-a-long-random-secret
# Production data access (the app runs with a seeded store when these are absent)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Optional. When empty, Phase 2 uses a Haversine straight-line estimate × 1.3.
OPENROUTESERVICE_API_KEY=

# A Telegram user ID granted access to the initial admin dashboard endpoints.
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# ── Telebirr (sandbox until Phase 5; set TELEBIRR_ENVIRONMENT=production only at launch) ──
# TELEBIRR_ENVIRONMENT=sandbox
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_MERCHANT_CODE=
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_PUBLIC_KEY=
# TELEBIRR_NOTIFY_URL=https://your-api.example.com/api/payments/telebirr/notify
# TELEBIRR_REDIRECT_URL=https://your-mini-app.example.com
# Use the sandbox mock checkout flow when no real credentials are set (defaults to true outside production).
# TELEBIRR_SANDBOX_MOCK=true
