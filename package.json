{
  "name": "allfreshmart-delivery-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "dev:api": "npm run dev --workspace=@allfreshmart/api",
    "dev:web": "npm run dev",
    "test": "npm run test --workspace=@allfreshmart/core && npm run test --workspace=@allfreshmart/api",
    "build": "next build --webpack"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
